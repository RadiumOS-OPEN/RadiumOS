{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Helios",
  "scopeName": "source.helios",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#function-def" },
    { "include": "#struct-def" },
    { "include": "#using" },
    { "include": "#include" },
    { "include": "#macros" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#calls" },
    { "include": "#type-names" },
    { "include": "#fields" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.helios",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.helios" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.helios" } }
        },
        {
          "name": "comment.line.double-slash.helios",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.helios" } }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.helios",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.helios" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.helios" } },
      "patterns": [
        { "name": "constant.character.escape.helios", "match": "\\\\(?:[nrt0\\\\\"']|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})" }
      ]
    },
    "chars": {
      "name": "string.quoted.single.char.helios",
      "match": "'(?:[^'\\\\]|\\\\(?:[nrt0\\\\\"']|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}))'",
      "captures": {}
    },
    "function-def": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.helios" },
        "2": { "name": "entity.name.function.helios" }
      }
    },
    "struct-def": {
      "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.struct.helios" },
        "2": { "name": "entity.name.type.struct.helios" }
      }
    },
    "using": {
      "match": "\\b(using)\\s*((?:::)?)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "keyword.other.using.helios" },
        "2": { "name": "keyword.operator.path.helios" },
        "3": { "name": "entity.name.namespace.helios" }
      }
    },
    "include": {
      "match": "\\b(include)\\s*(\"[^\"]*\")",
      "captures": {
        "1": { "name": "keyword.other.include.helios" },
        "2": { "name": "string.quoted.double.helios" }
      }
    },
    "macros": {
      "match": "\\b(asm|assert|print_hex)\\s*!?",
      "name": "support.macro.helios"
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.helios", "match": "\\b(if|else|for|while|loop|in|break|continue|return|match|step)\\b" },
        { "name": "storage.type.helios", "match": "\\b(let|const|fn|struct)\\b" },
        { "name": "storage.modifier.mut.helios", "match": "\\bmut\\b" },
        { "name": "keyword.other.unsafe.helios", "match": "\\bunsafe\\b" },
        { "name": "keyword.other.as.helios", "match": "\\bas\\b" },
        { "name": "keyword.operator.new.helios", "match": "\\bnew\\b" }
      ]
    },
    "types": {
      "name": "support.type.primitive.helios",
      "match": "\\b(int|str|bool|void|ptr|u8|u16|u32|i8|i16|i32|string)\\b"
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.helios", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.wildcard.helios", "match": "\\b_\\b" },
        { "name": "variable.other.constant.helios", "match": "\\b[A-Z][A-Z0-9_]{1,}\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.helios", "match": "\\b0[xX][0-9a-fA-F_]+(?:[ui](?:8|16|32))?\\b" },
        { "name": "constant.numeric.binary.helios", "match": "\\b0[bB][01_]+(?:[ui](?:8|16|32))?\\b" },
        { "name": "constant.numeric.integer.helios", "match": "\\b[0-9][0-9_]*(?:[ui](?:8|16|32))?\\b" }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.helios",
      "match": "\\b(print|println|input|peek|poke|malloc|free|memcpy|memset|strlen|strsub|strfind|strcmp|strcat|stoi|itos|ord|char_code|argc|argv|native|sleep_ms|get_ticks|shell|file_exists|file_size|file_read|file_write|file_append|dir_list|html_text|json_get|json_str|json_count|url_encode|url_decode|b64_decode|str_lower|str_find_at|str_pad|bar|color|rand|rand_range|abs|min|max|clamp|pow|mem_total_kb|mem_used_kb|mem_free_kb|cpu_vendor|cpu_brand|cpu_features|date_str|ramfs_stat|disk_stat|stdin_text)(?=\\s*\\()"
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": { "1": { "name": "entity.name.function.call.helios" } }
    },
    "type-names": {
      "name": "entity.name.type.helios",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "fields": {
      "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*\\()",
      "captures": {
        "1": { "name": "punctuation.accessor.helios" },
        "2": { "name": "variable.other.property.helios" }
      }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.helios", "match": "->|=>" },
        { "name": "keyword.operator.range.helios", "match": "\\.\\.=?" },
        { "name": "keyword.operator.path.helios", "match": "::" },
        { "name": "keyword.operator.comparison.helios", "match": "==|!=|<=|>=|(?<![<>-])[<>](?![<>=])" },
        { "name": "keyword.operator.logical.helios", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.helios", "match": "(?:\\+|-|\\*|/|%|&|\\||\\^)?=(?![=>])" },
        { "name": "keyword.operator.bitwise.helios", "match": "<<|>>|&|\\||\\^|~" },
        { "name": "keyword.operator.arithmetic.helios", "match": "[+\\-*/%]" }
      ]
    }
  }
}
