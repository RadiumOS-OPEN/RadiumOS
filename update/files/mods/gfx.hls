// Drawing helpers shared by the doom mods (no mod: header, so the menu skips it).
// screen = address of the 320x200 XRGB frame, font = address of the 8x8 font (argv(2), argv(4) of a mod).

fn gfx_char(screen: int, font: int, x: int, y: int, ch: int, color: int) {
    for row in 0..8 {
        let mut bits = 0;
        unsafe { bits = peek(font + ch * 8 + row, 8); }
        for col in 0..8 {
            let on = (bits >> col) & 1;
            if on == 1 {
                unsafe { poke(screen + ((y + row) * 320 + x + col) * 4, color, 32); }
            }
        }
    }
}

fn gfx_text(screen: int, font: int, x: int, y: int, text: int, color: int) {
    let n = strlen(text);
    for i in 0..n {
        gfx_char(screen, font, x + i * 8, y, ord(strsub(text, i, 1)), color);
    }
}
