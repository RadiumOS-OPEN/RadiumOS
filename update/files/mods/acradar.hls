// acmod: Radar: enemies (red) and team mates (green), top left
include "/disk/mods/ac.hls";

const R: int = 40;     // radar half size in pixels
const CX: int = 52;
const CY: int = 52;

fn blip(x: int, y: int, c: int) {
    ag_rect(x - 1, y - 1, 3, 3, c);
}

fn main() {
    if mod_frame() >= 0 {
        if in_game() == 1 {
            for i in 0..(2 * R + 1) {
                ag_px(CX - R + i, CY - R, 0x808080);
                ag_px(CX - R + i, CY + R, 0x808080);
                ag_px(CX - R, CY - R + i, 0x808080);
                ag_px(CX + R, CY - R + i, 0x808080);
            }
            blip(CX, CY, 0xFFFFFF);
            let n = api(A_NPL);
            for i in 0..n {
                // 19 units of x16 per pixel: the radar reaches about 48 cubes
                let rx = pl(i, P_RIGHT) / 19;
                let ry = pl(i, P_FWD) / 19;
                if rx > 0 - R && rx < R && ry > 0 - R && ry < R {
                    let mut c = 0x40FF40;
                    if pl(i, P_ENEMY) == 1 { c = 0xFF3030; }
                    blip(CX + rx, CY - ry, c);
                }
            }
        }
    }
}
