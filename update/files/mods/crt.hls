// mod: CRT monitor: scanlines and glow
include "/disk/mods/doom.hls";

fn main() {
    if mod_frame() < 0 {
        out_set(OUT_UPSCALE, 0);
        out_set(OUT_VIG, 0);
        out_set(OUT_SAT, 100);
    } else {
        out_set(OUT_UPSCALE, 3);
        out_set(OUT_VIG, 30);
        out_set(OUT_SAT, 120);
    }
}
