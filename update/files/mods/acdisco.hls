// acmod: Disco: the screen flashes in changing colours
include "/disk/mods/ac.hls";

fn main() {
    if mod_frame() < 0 {
        out_set(OUT_TINT_A, 0);
    } else {
        let beat = (now_ms() / 180) % 6;
        let mut r = 255; let mut g = 0; let mut b = 0;
        if beat == 1 { r = 255; g = 160; b = 0; }
        if beat == 2 { r = 0; g = 255; b = 60; }
        if beat == 3 { r = 0; g = 220; b = 255; }
        if beat == 4 { r = 60; g = 60; b = 255; }
        if beat == 5 { r = 255; g = 0; b = 200; }
        out_set(OUT_TINT_R, r);
        out_set(OUT_TINT_G, g);
        out_set(OUT_TINT_B, b);
        out_set(OUT_TINT_A, 35);
    }
}
