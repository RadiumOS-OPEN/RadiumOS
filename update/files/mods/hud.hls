// mod: Level timer and kill count on screen
include "/disk/mods/doom.hls";
include "/disk/mods/gfx.hls";

fn main() {
    if mod_frame() >= 0 {
        if in_level() == 1 {
            let secs = level_time() / 35;
            let m = secs / 60;
            let sc = secs - m * 60;
            let mut txt = "TIME " + itos(m) + ":";
            if sc < 10 { txt = txt + "0"; }
            txt = txt + itos(sc) + "  KILLS " + itos(kills());
            gfx_text(mod_screen(), mod_font(), 5, 5, txt, 0x000000);
            gfx_text(mod_screen(), mod_font(), 4, 4, txt, 0xFFD040);
        }
    }
}
