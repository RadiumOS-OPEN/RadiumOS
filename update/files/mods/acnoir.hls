// acmod: Noir: black and white film look
include "/disk/mods/ac.hls";

fn main() {
    if mod_frame() < 0 {
        out_set(OUT_SAT, 100);
        out_set(OUT_CON, 100);
        out_set(OUT_VIG, 0);
    } else {
        out_set(OUT_SAT, 0);
        out_set(OUT_CON, 130);
        out_set(OUT_VIG, 45);
    }
}
